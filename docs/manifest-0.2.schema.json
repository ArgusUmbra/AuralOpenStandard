{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:org.aural.audio-evidence:manifest-schema:0.2-draft",
  "title": "AURAL Draft 0.2 manifest",
  "description": "Structural schema. ZIP rules, duplicate-name rejection, I-JSON, and JCS byte canonicality require procedural validation.",
  "type": "object",
  "required": ["assets", "format", "original", "version"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "org.aural.audio-evidence"},
    "version": {"const": "0.2-draft"},
    "original": {"const": "audio/original.wav"},
    "title": {"type": "string", "maxLength": 4096},
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/originalAsset"}
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "maxLength": 255,
        "pattern": "^[a-z][a-z0-9+.-]*:[!-~]+$"
      },
      "additionalProperties": {"$ref": "#/$defs/interoperableValue"}
    },
    "critical_extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 255,
        "pattern": "^[a-z][a-z0-9+.-]*:[!-~]+$"
      }
    }
  },
  "$defs": {
    "originalAsset": {
      "type": "object",
      "required": ["media_type", "path", "role", "sha256", "size"],
      "additionalProperties": false,
      "properties": {
        "media_type": {"const": "audio/wav"},
        "path": {"const": "audio/original.wav"},
        "role": {"const": "original"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 0, "maximum": 8589934592}
      }
    },
    "interoperableValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "string"},
        {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        {"type": "array", "items": {"$ref": "#/$defs/interoperableValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/interoperableValue"}}
      ]
    }
  }
}
