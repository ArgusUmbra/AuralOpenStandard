{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:org.aural.provenance-event:schema:1",
  "title": "AURAL Experimental Provenance Signed Event v1",
  "description": "Structural companion schema. The prose specification is authoritative for JCS bytes, Unicode, number tokens, depth, extension criticality, cross-field equality, ordering, cryptography, and subject binding.",
  "type": "object",
  "additionalProperties": false,
  "required": ["assertion", "signature"],
  "properties": {
    "assertion": { "$ref": "#/$defs/assertion" },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "$defs": {
    "uuid4Urn": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "keyId": {
      "type": "string",
      "pattern": "^urn:aural:key:ed25519:[0-9a-f]{64}$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9+.-]*:[!-~]+$",
        "maxLength": 255
      }
    },
    "criticalExtensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9+.-]*:[!-~]+$",
        "maxLength": 255
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_schema",
        "event_schema_version",
        "signature_profile",
        "event_id",
        "event_type",
        "evidence_id",
        "signing_key_id",
        "subject",
        "parents",
        "claims"
      ],
      "properties": {
        "event_schema": { "const": "org.aural.provenance-event" },
        "event_schema_version": { "const": "1" },
        "signature_profile": { "const": "org.aural.signature.ed25519-jcs-v1" },
        "event_id": { "$ref": "#/$defs/uuid4Urn" },
        "event_type": { "const": "urn:aural:event:original-asset-acquired:1" },
        "evidence_id": { "$ref": "#/$defs/uuid4Urn" },
        "signing_key_id": { "$ref": "#/$defs/keyId" },
        "subject": { "$ref": "#/$defs/subject" },
        "parents": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/parent" }
        },
        "claims": { "$ref": "#/$defs/claims" },
        "extensions": { "$ref": "#/$defs/extensions" },
        "critical_extensions": { "$ref": "#/$defs/criticalExtensions" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "manifest_sha256", "original"],
      "properties": {
        "format": { "const": "org.aural.audio-evidence" },
        "version": { "const": "0.2-draft" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "original": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "byte_length"],
          "properties": {
            "path": { "const": "audio/original.wav" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "byte_length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8589934592
            }
          }
        }
      }
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "signed_event_digest"],
      "properties": {
        "event_id": { "$ref": "#/$defs/uuid4Urn" },
        "signed_event_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "const": "sha-256" },
            "value": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "claimedTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "value"],
      "properties": {
        "basis": { "enum": ["device-reported", "import", "signing"] },
        "value": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition_method",
        "source_type",
        "source_description",
        "acquiring_key_id",
        "key_protection",
        "earlier_modification_history"
      ],
      "properties": {
        "acquisition_method": {
          "enum": [
            "native-capture",
            "external-recorder-import",
            "received-evidence-import",
            "other-import"
          ]
        },
        "source_type": {
          "enum": ["device-microphone", "external-recorder", "received-evidence", "other"]
        },
        "source_description": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "acquiring_key_id": { "$ref": "#/$defs/keyId" },
        "key_protection": {
          "enum": ["software", "os-keystore", "hardware-backed", "secure-element", "unknown"]
        },
        "earlier_modification_history": { "enum": ["none-known", "known", "unknown"] },
        "claimed_times": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/claimedTime" }
        },
        "acquisition_environment": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "allOf": [
        {
          "if": { "properties": { "acquisition_method": { "const": "native-capture" } } },
          "then": { "properties": { "source_type": { "const": "device-microphone" } } }
        },
        {
          "if": { "properties": { "acquisition_method": { "const": "external-recorder-import" } } },
          "then": { "properties": { "source_type": { "const": "external-recorder" } } }
        },
        {
          "if": { "properties": { "acquisition_method": { "const": "received-evidence-import" } } },
          "then": { "properties": { "source_type": { "const": "received-evidence" } } }
        },
        {
          "if": { "properties": { "acquisition_method": { "const": "other-import" } } },
          "then": { "properties": { "source_type": { "const": "other" } } }
        }
      ]
    }
  }
}
