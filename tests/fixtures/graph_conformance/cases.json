  "cases": [
    {
      "id": "A-signed-root-no-package",
      "purpose": "One genuine signed root with no package supplied.",
      "signed_events": ["root"],
      "public_keys": ["test_key"],
      "expected": {
        "accepted": true,
        "status": "consistent",
        "declared_parent_closure": "closed",
        "history_completeness": "not_established",
        "package_integrity": "not_checked",
        "unique_event_count": 1,
        "duplicate_input_count": 0,
        "declared_parent_count": 0,
        "maximum_depth": 1,
        "ordered_events": ["root"]
      }
    },
    {
      "id": "B-signed-root-matching-package",
      "purpose": "The genuine root binds all six subject fields to an independently verified Draft 0.2 package.",
      "signed_events": ["root"],
      "public_keys": ["test_key"],
      "package": "matching",
      "expected": {
        "accepted": true,
        "status": "consistent",
        "declared_parent_closure": "closed",
        "history_completeness": "not_established",
        "package_integrity": "verified",
        "unique_event_count": 1,
        "duplicate_input_count": 0,
        "declared_parent_count": 0,
        "maximum_depth": 1,
        "ordered_events": ["root"]
      }
    },
    {
      "id": "C-parent-child",
      "purpose": "A genuine child supplied before its genuine parent resolves to exact parent-first order.",
      "signed_events": ["child", "root"],
      "public_keys": ["test_key"],
      "expected": {
        "accepted": true,
        "status": "consistent",
        "declared_parent_closure": "closed",
        "history_completeness": "not_established",
        "package_integrity": "not_checked",
        "unique_event_count": 2,
        "duplicate_input_count": 0,
        "declared_parent_count": 1,
        "maximum_depth": 2,
        "ordered_events": ["root", "child"]
      }
    },
    {
      "id": "D-identical-duplicates",
      "purpose": "Three byte-identical inputs collapse to one logical event and count two duplicates.",
      "signed_events": ["root", "root", "root"],
      "public_keys": ["test_key"],
      "expected": {
        "accepted": true,
        "status": "consistent",
        "declared_parent_closure": "closed",
        "history_completeness": "not_established",
        "package_integrity": "not_checked",
        "unique_event_count": 1,
        "duplicate_input_count": 2,
        "declared_parent_count": 0,
        "maximum_depth": 1,
        "ordered_events": ["root"]
      }
    },
    {
      "id": "E-independent-roots",
      "purpose": "Two independent roots use deterministic event-ID order despite reversed input order.",
      "signed_events": ["second_root", "root"],
      "public_keys": ["test_key"],
      "expected": {
        "accepted": true,
        "status": "consistent",
        "declared_parent_closure": "closed",
