  "cases": [
    {
      "id": "A-signed-root-no-package",
      "purpose": "One genuine signed root with no package supplied.",
      "signed_events": ["root"],
      "public_keys": ["test_key"],
      "expected": {
        "accepted": true,
        "status": "consistent",
        "declared_parent_closure": "closed",
        "history_completeness": "not_established",
        "package_integrity": "not_checked",
        "unique_event_count": 1,
        "duplicate_input_count": 0,
        "declared_parent_count": 0,
        "maximum_depth": 1,
        "ordered_events": ["root"]
      }
    },
    {
      "id": "B-signed-root-matching-package",
      "purpose": "The genuine root binds all six subject fields to an independently verified Draft 0.2 package.",
      "signed_events": ["root"],
      "public_keys": ["test_key"],
      "package": "matching",
      "expected": {
        "accepted": true,
        "status": "consistent",
        "declared_parent_closure": "closed",
        "history_completeness": "not_established",
        "package_integrity": "verified",
        "unique_event_count": 1,
        "duplicate_input_count": 0,
        "declared_parent_count": 0,
        "maximum_depth": 1,
        "ordered_events": ["root"]
      }
    },
    {
      "id": "C-parent-child",
      "purpose": "A genuine child supplied before its genuine parent resolves to exact parent-first order.",
      "signed_events": ["child", "root"],
      "public_keys": ["test_key"],
      "expected": {
        "accepted": true,
        "status": "consistent",
        "declared_parent_closure": "closed",
        "history_completeness": "not_established",
        "package_integrity": "not_checked",
        "unique_event_count": 2,
        "duplicate_input_count": 0,
        "declared_parent_count": 1,
        "maximum_depth": 2,
        "ordered_events": ["root", "child"]
      }
    },
    {
      "id": "D-identical-duplicates",
      "purpose": "Three byte-identical inputs collapse to one logical event and count two duplicates.",
      "signed_events": ["root", "root", "root"],
      "public_keys": ["test_key"],
      "expected": {
        "accepted": true,
        "status": "consistent",
        "declared_parent_closure": "closed",
        "history_completeness": "not_established",
        "package_integrity": "not_checked",
        "unique_event_count": 1,
        "duplicate_input_count": 2,
        "declared_parent_count": 0,
        "maximum_depth": 1,
        "ordered_events": ["root"]
      }
    },
    {
      "id": "E-independent-roots",
      "purpose": "Two independent roots use deterministic event-ID order despite reversed input order.",
      "signed_events": ["second_root", "root"],
      "public_keys": ["test_key"],
      "expected": {
        "accepted": true,
        "status": "consistent",
        "declared_parent_closure": "closed",
        "history_completeness": "not_established",
        "package_integrity": "not_checked",
        "unique_event_count": 2,
        "duplicate_input_count": 0,
        "declared_parent_count": 0,
        "maximum_depth": 1,
        "ordered_events": ["root", "second_root"]
      }
    },
    {
      "id": "F-multi-parent-history",
      "purpose": "A genuinely signed event references two exact genuine parents and follows both in dependency order.",
      "signed_events": ["multi_parent", "second_root", "root"],
      "public_keys": ["test_key"],
      "expected": {
        "accepted": true,
        "status": "consistent",
        "declared_parent_closure": "closed",
        "history_completeness": "not_established",
        "package_integrity": "not_checked",
        "unique_event_count": 3,
        "duplicate_input_count": 0,
        "declared_parent_count": 2,
        "maximum_depth": 2,
        "ordered_events": ["root", "second_root", "multi_parent"]
      }
    },
    {
      "id": "G-input-order-independence",
      "purpose": "The same multi-parent graph in a different input order has the identical normalized result.",
      "signed_events": ["root", "multi_parent", "second_root"],
      "public_keys": ["test_key"],
      "equivalent_to": "F-multi-parent-history",
      "expected": {
        "accepted": true,
        "status": "consistent",
        "declared_parent_closure": "closed",
        "history_completeness": "not_established",
        "package_integrity": "not_checked",
        "unique_event_count": 3,
        "duplicate_input_count": 0,
        "declared_parent_count": 2,
        "maximum_depth": 2,
        "ordered_events": ["root", "second_root", "multi_parent"]
      }
    },
    {
      "id": "H-parent-fanout-64",
      "purpose": "A genuinely signed event with exactly 64 exact parent references is accepted at the profile boundary.",
      "resource_bundle": {
        "bundle": "graph_resources",
        "collection": "fanout_64"
      },
      "public_keys": ["test_key"],
      "claims": {
        "all_event_signatures_valid": true
      },
      "expected": {
        "accepted": true,
        "status": "consistent",
        "declared_parent_closure": "closed",
        "history_completeness": "not_established",
        "package_integrity": "not_checked",
        "unique_event_count": 65,
        "duplicate_input_count": 0,
        "declared_parent_count": 64,
        "maximum_depth": 2,
        "ordered_event_source": "resource_bundle_order"
      }
    },
    {
      "id": "I-graph-depth-256",
      "purpose": "A genuinely signed chain whose root-counted maximum depth is exactly 256 is accepted at the profile boundary.",
      "resource_bundle": {
        "bundle": "graph_resources",
        "collection": "depth_256"
      },
      "public_keys": ["test_key"],
      "claims": {
        "all_event_signatures_valid": true
      },
      "expected": {
        "accepted": true,
        "status": "consistent",
        "declared_parent_closure": "closed",
        "history_completeness": "not_established",
        "package_integrity": "not_checked",
        "unique_event_count": 256,
        "duplicate_input_count": 0,
        "declared_parent_count": 255,
        "maximum_depth": 256,
        "ordered_event_source": "resource_bundle_order"
      }
    },
    {
      "id": "N01-invalid-ed25519-signature",
      "purpose": "A structurally valid canonical event is rejected when its Ed25519 signature is invalid.",
      "signed_events": ["invalid_signature"],
      "public_keys": ["test_key"],
      "expected": {
        "accepted": false,
        "error": {
          "category": "signature",
          "stage": "signature"
        }
      }
    },
    {
      "id": "N02-missing-declared-parent",
      "purpose": "A valid signed child is rejected when its declared parent is omitted from the supplied records.",
      "signed_events": ["child"],
      "public_keys": ["test_key"],
      "expected": {
        "accepted": false,
        "error": {
          "category": "missing_parent",
          "stage": "graph"
        }
      }
    },
    {
      "id": "N03-parent-digest-mismatch",
      "purpose": "A genuinely signed child is rejected when its supplied parent's signed-event digest does not match the declared reference.",
      "signed_events": ["parent_digest_mismatch", "root"],
      "public_keys": ["test_key"],
      "expected": {
        "accepted": false,
        "error": {
          "category": "parent_digest_mismatch",
          "stage": "graph"
        }
      }
    },
    {
      "id": "N04-unrelated-valid-package",
      "purpose": "A genuine signed root is rejected when bound to an independently valid package with a different manifest subject.",
      "signed_events": ["root"],
      "public_keys": ["test_key"],
      "package": "unrelated",
      "expected": {
        "accepted": false,
        "error": {
          "category": "subject_binding",
          "stage": "package"
        }
      }
    },
    {
      "id": "N05-corrupted-original-audio",
      "purpose": "A genuine signed root is rejected during independent archive verification when the original WAV bytes do not match the manifest integrity value.",
      "signed_events": ["root"],
      "public_keys": ["test_key"],
      "package": "corrupted_original_audio",
      "expected": {
        "accepted": false,
        "error": {
          "category": "package_integrity",
          "stage": "package"
        }
      }
    },
    {
      "id": "N06-invalid-manifest",
      "purpose": "A genuine signed root is rejected during independent archive verification when the ZIP opens but manifest.json is malformed JSON.",
      "signed_events": ["root"],
      "public_keys": ["test_key"],
      "package": "invalid_manifest",
      "expected": {
        "accepted": false,
        "error": {
          "category": "package_integrity",
          "stage": "package"
        }
      }
    },
    {
      "id": "N07-invalid-zip-structure",
      "purpose": "A genuine signed root is rejected during independent archive verification when the ZIP local file header signature is malformed.",
      "signed_events": ["root"],
      "public_keys": ["test_key"],
      "package": "invalid_zip_structure",
      "expected": {
        "accepted": false,
        "error": {
          "category": "package_integrity",
          "stage": "package"
        }
      }
    },
    {
      "id": "N08-missing-signing-key",
      "purpose": "A valid signed root is rejected when no public-key record matches its signing key identifier.",
      "signed_events": ["root"],
      "public_keys": [],
      "expected": {
        "accepted": false,
        "error": {
          "category": "missing_key",
          "stage": "key"
        }
      }
    },
    {
      "id": "N09-malformed-public-key",
      "purpose": "A valid signed root is rejected when the supplied canonical key record uses forbidden padded base64url encoding.",
      "signed_events": ["root"],
      "public_keys": ["malformed_key"],
      "expected": {
        "accepted": false,
        "error": {
          "category": "encoding",
          "stage": "key"
        }
      }
    },
    {
      "id": "N10-incorrect-key-id",
      "purpose": "A valid signed root is rejected when the supplied key record's declared identifier does not match its public-key bytes.",
      "signed_events": ["root"],
      "public_keys": ["incorrect_key_id"],
      "expected": {
        "accepted": false,
        "error": {
          "category": "key_id_mismatch",
          "stage": "key"
        }
      }
    },
    {
      "id": "N11-duplicate-public-key-id",
      "purpose": "A valid signed root is rejected when the same valid public-key record is supplied twice.",
      "signed_events": ["root"],
      "public_keys": ["test_key", "test_key"],
      "expected": {
        "accepted": false,
        "error": {
          "category": "duplicate_key",
          "stage": "key"
        }
      }
    },
    {
      "id": "N12-invalid-ed25519-profile",
      "purpose": "A canonical root with an out-of-range Ed25519 scalar is rejected by the strict signature profile.",
      "signed_events": ["invalid_signature_scalar"],
      "public_keys": ["test_key"],
      "expected": {
        "accepted": false,
        "error": {
          "category": "signature",
          "stage": "signature"
        }
      }
    },
    {
      "id": "N13-parent-fanout-65",
      "purpose": "A genuinely signed event with 65 exact valid parent references is rejected at the graph resource boundary.",
      "resource_bundle": {
        "bundle": "graph_resources",
        "collection": "fanout_65"
      },
      "public_keys": ["test_key"],
      "claims": {
        "all_event_signatures_valid": true
      },
      "expected": {
        "accepted": false,
        "error": {
          "category": "resource_limit",
          "stage": "graph"
        }
      }
    },
    {
      "id": "N14-graph-depth-257",
      "purpose": "A genuinely signed chain reaching root-counted depth 257 is rejected at the graph resource boundary.",
      "resource_bundle": {
        "bundle": "graph_resources",
        "collection": "depth_257"
      },
      "public_keys": ["test_key"],
      "claims": {
        "all_event_signatures_valid": true
      },
      "expected": {
        "accepted": false,
        "error": {
          "category": "resource_limit",
          "stage": "graph"
        }
      }
    },
    {
      "id": "N15-competing-malformed-forward",
      "purpose": "Two differently malformed signed-event records deterministically select the same semantic failure in forward input order.",
      "signed_events": ["invalid_noncanonical", "invalid_bom"],
      "public_keys": ["test_key"],
      "expected": {
        "accepted": false,
        "error": {
          "category": "canonicalization",
          "stage": "record"
        }
      }
    },
    {
      "id": "N16-competing-malformed-reverse",
      "purpose": "The same malformed records in reverse input order produce the identical deterministic failure.",
      "signed_events": ["invalid_bom", "invalid_noncanonical"],
      "public_keys": ["test_key"],
      "equivalent_to": "N15-competing-malformed-forward",
      "expected": {
        "accepted": false,
        "error": {
          "category": "canonicalization",
          "stage": "record"
        }
      }
    }
  ]
