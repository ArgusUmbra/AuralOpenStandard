        "maximum_depth": 1,
        "ordered_events": ["root", "second_root"]
      }
    },
    {
      "id": "F-multi-parent-history",
      "purpose": "A genuinely signed event references two exact genuine parents and follows both in dependency order.",
      "signed_events": ["multi_parent", "second_root", "root"],
      "public_keys": ["test_key"],
      "expected": {
        "accepted": true,
        "status": "consistent",
        "declared_parent_closure": "closed",
